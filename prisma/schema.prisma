generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id
  email      String  @unique
  name       String?
  profileUrl String?

  firstName String?
  lastName  String?
  bio       String?

  isOnboarded Boolean? @default(false)

  noOfQuestionsSolved Int?     @default(0)
  beltRank            BeltType @default(white_belt)

  discussions Discussion[]
  comments    Comment[]

  likes     Like[]
  bookmarks Bookmark[]

  role           String  @default("user")
  isShadowBanned Boolean @default(false)
  isBanned       Boolean @default(false)
  sudoPassword   String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userProgresses  UserProgress[]
  shelves         Shelf[]
  socialLinks     SocialLink[]
  reportsCreated  Report[]       @relation("ReportsGiven")
  reportsReceived Report[]       @relation("ReportsReceived")
}

model SocialLink {
  id String @id @default(cuid())

  platform    String
  platformUrl String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
}

model Discussion {
  id          String @id @default(cuid())
  title       String
  description String

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  comments    Comment[]
  attachments Attachment[]

  likes        Like[]
  likeCount    Int    @default(0)
  dislikeCount Int    @default(0)

  bookmarks Bookmark[]

  reports Report[]

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id          String @id @default(cuid())
  description String

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentChildren", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies  Comment[] @relation("CommentChildren")

  attachments Attachment?

  likes        Like[]
  likeCount    Int    @default(0)
  dislikeCount Int    @default(0)

  bookmarks Bookmark[]

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id String @id

  postUrl String
  type    AttachmentType

  discussionId String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  commentId String?  @unique
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Like {
  id String @id @default(cuid())

  type LikeType

  discussionId String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, discussionId])
  @@unique([userId, commentId])
}

model Bookmark {
  id String @id @default(cuid())

  discussionId String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, discussionId])
  @@unique([userId, commentId])
}

model Report {
  id String @id @default(cuid())

  reason String

  reporterId String
  reporter   User   @relation("ReportsGiven", fields: [reporterId], references: [id])

  discussionId String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: SetNull)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  reportedId String?
  reported   User?   @relation("ReportsReceived", fields: [reportedId], references: [id])

  status    ReportStatusType @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Question {
  id String @id @default(cuid())

  slug        String     @unique
  title       String
  description String
  difficulty  Difficulty @default(Medium)

  categories Category[]
  companyTag Company[]

  externalPlatformUrl String
  solutionUrl         String

  timeLimit   Int @default(2000)
  memoryLimit Int @default(256)

  noOfSubmissions  Int @default(0)
  noOfPeopleSolved Int @default(0)

  userProgresses UserProgress[]
  judgeType      JudgeType      @default(EXACT_MATCH)
  hasChecker     Boolean        @default(false)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  shelves        Shelf[]
  codestubs      Codestub[]
  testcases      Testcase[]
  customCheckers CustomChecker[]

  @@index([difficulty])
}

model Category {
  id String @id @default(cuid())

  name              String     @unique
  slug              String     @unique
  categoryOrder     Int        @default(99)
  prerequisiteArray Category[] @relation("CategoryDependencies")
  unlocks           Category[] @relation("CategoryDependencies")

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryOrder])
}

model Company {
  id String @id @default(cuid())

  name       String  @unique
  slug       String  @unique
  logo       String? @unique
  logoId     String? @unique
  websiteUrl String?

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProgress {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  status QuestionStatusType @default(unvisited)

  userCode   String? @db.Text
  timeTaken  Int     @default(0)
  memoryUsed Int     @default(0)

  testcasesPassed Int @default(0)
  totalTestcases  Int @default(0)

  errorLog String?
  result   ResultType @default(PENDING)

  languageId String?
  language   Language? @relation(fields: [languageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, questionId])
  @@index([questionId])
}

model Tag {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  color String? @default("blue")

  discussions Discussion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shelf {
  id String @id @default(cuid())

  type       ShelfType
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, userId])
}

model Language {
  id         String @id @default(cuid())
  name       String @unique
  slug       String @unique
  monacoSlug String
  extension  String

  dockerImage String
  compileCmd  String?
  runCmd      String

  isSupported Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userProgress   UserProgress[]
  codestubs      Codestub[]
  customCheckers CustomChecker[]

  @@index([slug])
}

model Codestub {
  id String @id @default(cuid())

  userSnippet String @db.Text
  driverCode  String @db.Text

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([questionId, languageId])
}

model Testcase {
  id String @id @default(cuid())

  input          String  @db.Text
  expectedOutput String  @db.Text
  isHidden       Boolean

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model CustomChecker {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onUpdate: Cascade)

  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  scriptSource String @db.Text

  timeoutMs Int      @default(2000)
  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([questionId, version])
}

//enums
enum ShelfType {
  later
  revisit
  stuck
  important
}

enum QuestionStatusType {
  completed
  attempted
  unvisited
}

enum AttachmentType {
  image
  video
  gif
}

enum LikeType {
  like
  dislike
}

enum TagType {
  Discussion
  Senseis_Wisdom
  Guidance_Needed
  Kata
  Ronins_Path
  Dojo_Life
  Showcase
  Dynamic_Programming
  Graphs_n_Trees
  Arrays_n_Strings
  Recursion
  Bit_Manipulation
  System_Design
  Math_n_Geometry
  TypeScript_JavaScript
  Python
  CPP_n_C
  Java
  Rust
  Gate
  SQL
  NoSQL
  Frontend
  Backend
  Job
  Placement
}

enum BeltType {
  white_belt
  yellow_belt
  orange_belt
  green_belt
  blue_belt
  purple_belt
  brown_belt
  black_belt
}

enum ReportStatusType {
  PENDING
  REVIEWED
  DISMISSED
}

enum Difficulty {
  Easy
  Hard
  Medium
}

enum ResultType {
  PENDING
  RUNNING
  SUCCESS
  WRONG
  RUNTIME_ERROR
  COMPILE_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  SYSTEM_ERROR
}

enum JudgeType {
  EXACT_MATCH
  UNORDERED_MATCH
  SPECIAL_JUDGE
}
